    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nif (!body.targetUrl || typeof body.targetUrl !== 'string') {\n  throw new Error('targetUrl is required');\n}\nconst competitors = Array.isArray(body.competitors)\n  ? body.competitors.filter(Boolean).slice(0, 3)\n  : [];\nreturn [{ json: {\n  targetUrl: body.targetUrl.trim(),\n  businessName: String(body.businessName ?? '').trim(),\n  location: String(body.location ?? '').trim(),\n  language: String(body.language ?? 'en-CA').trim(),\n  primaryGoal: String(body.primaryGoal ?? 'Generate qualified enquiries').trim(),\n  competitors,\n  ga4: body.ga4 && typeof body.ga4 === 'object' ? body.ga4 : {}\n} }];"
      },
      "id": "5c2c86ce-2379-450e-b6c2-56e754296f60",
      "name": "Validate Audit Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.VANTAGE_WORKER_URL}}/audits",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "content-type", "value": "application/json" },
            { "name": "x-vantage-secret", "value": "={{$env.VANTAGE_WEBHOOK_SECRET}}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}",
        "options": {
