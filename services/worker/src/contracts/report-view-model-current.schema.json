{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vantage-platform.io/prysm/contracts/v2/report-view-model.schema.json",
  "title": "Current Report View Model",
  "description": "Versioned current ReportViewModel contract. Historical v1 remains frozen for compatibility.",
  "type": "object",
  "version": "2.0.0",
  "contractVersion": "2.0.0",
  "additionalProperties": false,
  "required": ["contractVersion","reportVersion","reportDesignVersion","generatedAt","input","scores","bands","assessedWeight","readinessStatus","showNumericScore","evidenceConfidenceScore","rootCause","rootCauseRuleId","decisionHierarchy","findings","conversionPaths","readinessMap","contentIdeas","competitors","sourceStatus","limitations","evidence","capabilityEvidence","narrative","gate"],
  "properties": {
    "contractVersion": { "const": "2.0.0" },
    "reportVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "reportDesignVersion": { "type": "string", "const": "1.0.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "input": { "type": "object", "required": ["targetUrl"], "additionalProperties": true },
    "scores": { "type": "object" },
    "bands": { "type": "object" },
    "assessedWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
    "readinessStatus": { "type": "string" },
    "showNumericScore": { "type": "boolean" },
    "evidenceConfidenceScore": { "type": "number", "minimum": 0, "maximum": 100 },
    "rootCause": { "type": "string" },
    "rootCauseRuleId": { "type": "string", "minLength": 1 },
    "decisionHierarchy": { "type": "object", "required": ["rootCauseRuleId","orderedFindingIds","actions"], "additionalProperties": true },
    "findings": { "type": "array" },
    "conversionPaths": { "type": "array" },
    "readinessMap": { "type": "array" },
    "contentIdeas": { "type": "object" },
    "competitors": { "type": "object" },
    "sourceStatus": { "type": "object" },
    "limitations": { "type": "array" },
    "evidence": { "type": ["object","null"] },
    "capabilityEvidence": { "type": "object" },
    "narrative": { "type": "object" },
    "gate": { "type": "object" }
  }
}
