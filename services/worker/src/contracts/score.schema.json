{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vantage-platform.io/prysm/contracts/v1/score.schema.json",
  "title": "Score Set",
  "description": "Deterministic scoring output persisted as scores.json. Findings are stored in a separate findings.json artifact and referenced by findingIds and findingsArtifact.",
  "type": "object",
  "version": "1.0.0",
  "contractVersion": "1.0.0",
  "required": [
    "contractVersion",
    "scoringVersion",
    "generatedAt",
    "scores",
    "bands",
    "assessedWeight",
    "readinessStatus",
    "showNumericScore",
    "evidenceConfidenceScore",
    "dimensionEligibility",
    "moduleEligibility",
    "suppressedModules",
    "rootCause",
    "findingIds"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "scoringVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "scores": {
      "type": "object",
      "required": ["trust", "contentDepth", "conversionPathways", "technical", "performance", "conversionReadiness"],
      "properties": {
        "trust": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "contentDepth": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "conversionPathways": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "technical": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "performance": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "conversionReadiness": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "awareness": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "consideration": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "decision": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "aiReadiness": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "conversionPathwaysDimension": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "trustEeatDimension": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "contentFunnelDimension": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "technicalPerformanceDimension": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
        "entitySchemaAiDimension": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
      }
    },
    "bands": {
      "type": "object",
      "required": ["conversionReadiness", "trust", "evidenceConfidence"],
      "properties": {
        "conversionReadiness": { "type": "string", "enum": ["Strong", "Moderate", "Limited", "Weak", "Not Assessed"] },
        "trust": { "type": "string", "enum": ["Strong", "Moderate", "Limited", "Weak", "Not Assessed"] },
        "evidenceConfidence": { "type": "string", "enum": ["High", "Moderate", "Limited", "Directional", "Not Assessed"] }
      }
    },
    "assessedWeight": { "type": "integer", "minimum": 0, "maximum": 100 },
    "readinessStatus": { "type": "string" },
    "readinessStatusDetail": { "type": "string" },
    "showNumericScore": { "type": "boolean" },
    "evidenceConfidenceScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "evidenceConfidenceFactors": {
      "type": "object",
      "description": "Named evidence confidence factors with scores (0-100)."
    },
    "dimensionEligibility": {
      "type": "object",
      "required": ["conversion_pathways", "trust_eeat", "content_funnel", "technical_performance", "entity_schema_ai"],
      "properties": {
        "conversion_pathways": { "type": "boolean" },
        "trust_eeat": { "type": "boolean" },
        "content_funnel": { "type": "boolean" },
        "technical_performance": { "type": "boolean" },
        "entity_schema_ai": { "type": "boolean" }
      }
    },
    "moduleEligibility": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "suppressedModules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["moduleId", "dimension", "label", "reason"],
        "properties": {
          "moduleId": { "type": "string" },
          "dimension": { "type": "string" },
          "label": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "rootCause": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "findingCount": { "type": "integer", "minimum": 0 },
    "findingIds": { "type": "array", "items": { "type": "string" } },
    "findingsArtifact": {
      "type": ["object", "null"],
      "properties": {
        "key": { "type": "string" },
        "sha256": { "type": "string" },
        "bytes": { "type": "integer" }
      }
    },
    "scoresArtifact": {
      "type": ["object", "null"],
      "properties": {
        "key": { "type": "string" },
        "sha256": { "type": "string" },
        "bytes": { "type": "integer" }
      }
    },
    "conversionPaths": { "type": "array" },
    "readinessMap": { "type": "array" },
    "contentIdeas": { "type": "object" },
    "competitors": { "type": "object" },
    "renderingDiagnostics": { "type": "array" },
    "sourceDependencies": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "enum": ["AVAILABLE", "PARTIAL", "FAILED", "BLOCKED", "UNAVAILABLE", "NOT_CONNECTED", "NOT_APPLICABLE"]
      }
    }
  }
}
