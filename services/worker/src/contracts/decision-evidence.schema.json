{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vantage-platform.io/prysm/contracts/v1/decision-evidence.schema.json",
  "title": "Decision Evidence",
  "description": "Governed hydrated evidence model built from validated persisted SourceResults. Feeds scoring and rendering.",
  "type": "object",
  "version": "1.0.0",
  "contractVersion": "1.0.0",
  "required": ["contractVersion", "decisionEvidenceVersion"],
  "allOf": [
    {
      "description": "DE-04: AVAILABLE/PARTIAL site evidence must carry the structural data that scoring and rendering require. Malformed available evidence (missing domain/pages/services/trust/platform/schemaTypes) is a contract violation and must fail validation. Unavailable states (FAILED/BLOCKED/UNAVAILABLE/NOT_CONNECTED/NOT_APPLICABLE) may have reduced fields.",
      "if": {
        "properties": {
          "site": {
            "type": "object",
            "required": ["sourceStatus"],
            "properties": {
              "sourceStatus": { "enum": ["AVAILABLE", "PARTIAL"] }
            }
          }
        }
      },
      "then": {
        "properties": {
          "site": {
            "type": "object",
            "required": [
              "domain",
              "pages",
              "services",
              "trust",
              "platform",
              "schemaTypes"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "decisionEvidenceVersion": { "const": "1.0.0" },
    "site": {
      "type": "object",
      "description": "Site (crawl) evidence — a mandatory source for every audit. Missing site evidence (null) is a contract violation: the source plan always includes the on-page crawl.",
      "required": ["sourceStatus"],
      "properties": {
        "sourceStatus": { "type": "string" },
        "collectedAt": { "type": "string" },
        "domain": { "type": "string" },
        "targetUrl": { "type": "string" },
        "pageCount": { "type": "integer" },
        "pages": { "type": "array" },
        "services": { "type": "array" },
        "topicKeywords": { "type": "array" },
        "ctas": { "type": "array" },
        "forms": { "type": "array" },
        "externalCtas": { "type": "array" },
        "socialLinks": { "type": "array" },
        "trust": { "type": "object" },
        "platform": { "type": "string" },
        "schemaTypes": { "type": "array" },
        "statusCounts": { "type": "object" },
        "totalWords": { "type": "integer" },
        "averageWords": { "type": "integer" },
        "missingTitles": { "type": "integer" },
        "missingDescriptions": { "type": "integer" },
        "missingCanonicals": { "type": "integer" },
        "h1Missing": { "type": "integer" },
        "h1Multiple": { "type": "integer" },
        "imageCount": { "type": "integer" },
        "imagesMissingAlt": { "type": "integer" },
        "internalLinkCount": { "type": "integer" },
        "brokenInternalLinks": { "type": "array" },
        "securityHeaders": { "type": "object" },
        "_contentEvidenceAvailable": { "type": "boolean" },
        "_responseHeadersAvailable": { "type": "boolean" },
        "limitations": { "type": "array" },
        "coverage": { "type": "object" }
      }
    },
    "performance": {
      "type": ["object", "null"],
      "required": ["sourceStatus"],
      "properties": {
        "sourceStatus": { "type": "string" },
        "collectedAt": { "type": "string" },
        "provider": { "type": "string" },
        "fallbackUsed": { "type": "boolean" },
        "testedUrls": { "type": "array" },
        "mobile": { "type": "object" },
        "desktop": { "type": "object" },
        "renderingDiagnostics": { "type": "object" },
        "limitations": { "type": "array" },
        "coverage": { "type": "object" }
      }
    },
    "competitors": {
      "type": ["array", "null"],
      "items": { "type": "object" }
    },
    "backlinks": {
      "type": ["object", "null"],
      "properties": {
        "sourceStatus": { "type": "string" },
        "collectedAt": { "type": "string" },
        "provider": { "type": "string" },
        "adapterVersion": { "type": "string" },
        "limitations": { "type": "array" }
      }
    },
    "ga4": {
      "type": ["object", "null"],
      "properties": {
        "sourceStatus": { "type": "string" },
        "collectedAt": { "type": "string" },
        "provider": { "type": "string" },
        "adapterVersion": { "type": "string" },
        "limitations": { "type": "array" }
      }
    },
    "gsc": {
      "type": ["object", "null"],
      "properties": {
        "sourceStatus": { "type": "string" },
        "collectedAt": { "type": "string" },
        "provider": { "type": "string" },
        "adapterVersion": { "type": "string" },
        "limitations": { "type": "array" }
      }
    },
    "competitorOpportunities": {
      "type": ["object", "null"]
    }
  }
}
