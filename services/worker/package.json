{
  "name": "vantage-worker",
  "version": "0.2.0",
  "description": "Vantage website evidence, scoring, and locked-report worker",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "audit": "node src/runners/run-audit.js",
    "test": "node --test src/evidence/*.test.js src/scoring/*.test.js src/report/*.test.js src/audit/*.test.js src/storage/*.test.js src/adapters/**/*.test.js src/auth/*.test.js src/n8n/*.test.js",
    "test:backlinks": "node --test src/evidence/backlinks-provider.test.js",
    "check:template": "node src/report/verify-template.js",
    "test:schemas": "node --test src/contracts/validator.test.js",
    "test:artifacts": "node --test test-fixtures/artifacts/memory-artifact-store.test.js test-fixtures/artifacts/fs-artifact-store.test.js test-fixtures/artifacts/object-artifact-store.test.js",
    "test:lifecycle": "node --test test-fixtures/lifecycle/memory-repository.test.js test-fixtures/lifecycle/postgres-repository.test.js",
    "acceptance:wp2": "node scripts/acceptance-wp2.js",
    "acceptance:wp3": "node scripts/acceptance-wp3.js",
    "acceptance:wp4": "node scripts/acceptance-wp4.js",
    "acceptance:task7": "node scripts/acceptance-task7.js",
    "acceptance:task9": "node scripts/acceptance-task9.js",
    "acceptance:task10": "node scripts/acceptance-task10.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.2.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "chrome-launcher": "^1.0.0",
    "google-auth-library": "^10.3.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
}
