  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.2.0",
    "pg": "^8.16.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "chrome-launcher": "^1.0.0",
    "google-auth-library": "^10.3.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "pg-mem": "^3.0.14"
  }
