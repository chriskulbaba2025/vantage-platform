{
  "name": "vantage-worker",
  "version": "0.2.0",
  "description": "Vantage website evidence, scoring, and locked-report worker",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "audit": "node src/runners/run-audit.js",
    "test": "node --test src/evidence/*.test.js src/scoring/*.test.js src/report/*.test.js src/audit/*.test.js src/storage/*.test.js src/adapters/**/*.test.js src/auth/*.test.js",
    "test:backlinks": "node --test src/evidence/backlinks-provider.test.js",
    "check:template": "node src/report/verify-template.js",
    "acceptance:task7": "node scripts/acceptance-task7.js",
    "acceptance:task9": "node scripts/acceptance-task9.js",
    "acceptance:task10": "node scripts/acceptance-task10.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "cheerio": "^1.2.0"
  },
  "optionalDependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "chrome-launcher": "^1.0.0",
    "google-auth-library": "^10.3.0",
    "lighthouse": "^12.8.2",
    "playwright": "^1.61.1"
  }
}
